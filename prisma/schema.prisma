generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  SUPER_ADMIN
  AUCTION_ADMIN
  TEAM_OWNER
  TEAM_MANAGER
  VIEWER
}
model Auction {
  id String @id
  revision Int
  snapshot Json
  updatedAt DateTime @updatedAt
  bids Bid[]
  sets AuctionSet[]
  queue AuctionQueue[]
  settings AuctionSettings?
}
model User {
  id String @id
  email String @unique
  name String
  passwordHash String
  role Role
  enabled Boolean @default(true)
  members TeamMember[]
  sessions Session[]
  bids Bid[]
}
model Team {
  id String @id
  name String
  purse Int
  startingPurse Int
  enabled Boolean
  data Json
  members TeamMember[]
  bids Bid[]
  purchases Purchase[]
  shortlist TeamShortlist[]
  notifications Notification[]
  results AuctionResult[]
}
model TeamMember {
  id String @id
  teamId String
  userId String @unique
  team Team @relation(fields:[teamId],references:[id])
  user User @relation(fields:[userId],references:[id])
}
model Player {
  id String @id
  name String
  status String
  basePrice Int
  data Json
  bids Bid[]
  purchases Purchase[]
  results AuctionResult[]
  queue AuctionQueue[]
  shortlist TeamShortlist[]
}
model AuctionSet {
  id String @id
  auctionId String
  name String
  order Int
  auction Auction @relation(fields:[auctionId],references:[id])
}
model AuctionQueue {
  id String @id
  auctionId String
  playerId String
  order Int
  auction Auction @relation(fields:[auctionId],references:[id])
  player Player @relation(fields:[playerId],references:[id])
  @@unique([auctionId,playerId])
}
model Bid {
  id String @id
  auctionId String
  playerId String
  teamId String
  userId String
  amount Int
  bidType String
  status String
  requestId String
  createdAt DateTime
  auction Auction @relation(fields:[auctionId],references:[id])
  player Player @relation(fields:[playerId],references:[id])
  team Team @relation(fields:[teamId],references:[id])
  user User @relation(fields:[userId],references:[id])
  @@unique([userId,requestId])
  @@index([auctionId,playerId,createdAt])
}
model Purchase {
  id String @id
  playerId String
  teamId String
  amount Int
  active Boolean @default(true)
  createdAt DateTime
  player Player @relation(fields:[playerId],references:[id])
  team Team @relation(fields:[teamId],references:[id])
}
model AuctionResult {
  id String @id
  playerId String
  teamId String?
  amount Int
  status String
  round Int
  createdAt DateTime
  player Player @relation(fields:[playerId],references:[id])
  team Team? @relation(fields:[teamId],references:[id])
}
model BidIncrementRule {
  id String @id
  from Int
  increment Int
}
model TeamShortlist {
  id String @id
  teamId String
  playerId String
  data Json
  team Team @relation(fields:[teamId],references:[id])
  player Player @relation(fields:[playerId],references:[id])
  @@unique([teamId,playerId])
}
model Notification {
  id String @id
  teamId String
  message String
  createdAt DateTime
  team Team @relation(fields:[teamId],references:[id])
}
model AuditLog {
  id String @id
  userId String
  action String
  entity String
  before Json
  after Json
  ip String
  createdAt DateTime
  @@index([createdAt])
}
model AuctionSettings {
  id String @id
  auctionId String @unique
  data Json
  auction Auction @relation(fields:[auctionId],references:[id])
}
model Session {
  id String @id
  tokenHash String @unique
  userId String
  csrf String
  expiresAt DateTime
  user User @relation(fields:[userId],references:[id])
}
